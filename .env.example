# Copy to .env and fill in. Generate the key in FoxCloud: profile icon -> API Management -> Generate API key.
FOX_API_KEY=
# Optional: pin a device serial number. If empty the first inverter on the account is used.
FOX_DEVICE_SN=
# Site location for the solar forecast (Open-Meteo, no key needed). Example: Brisbane.
LAT=-27.47
LON=153.03
TZ=Australia/Brisbane
