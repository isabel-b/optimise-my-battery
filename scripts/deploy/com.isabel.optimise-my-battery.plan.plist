<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.isabel.optimise-my-battery.plan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_REPO_PATH/scripts/deploy/plan-daily.sh</string>
    </array>
    <key>UserName</key>
    <string>REPLACE_WITH_USER</string>
    <key>WorkingDirectory</key>
    <string>REPLACE_WITH_REPO_PATH</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <!-- No RunAtLoad: the decision only makes sense just before the window opens. -->
    <key>StandardOutPath</key>
    <string>REPLACE_WITH_REPO_PATH/scripts/deploy/logs/plan.out.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_REPO_PATH/scripts/deploy/logs/plan.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>OMB_REPO</key>
        <string>REPLACE_WITH_REPO_PATH</string>
        <key>OMB_USER</key>
        <string>REPLACE_WITH_USER</string>
    </dict>
</dict>
</plist>
